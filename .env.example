# Copy to `.env` (gitignored, never committed) and fill in real values.

# Required for any SEC EDGAR access. SEC's fair-access policy requires every
# API client to identify itself with a real contact -- see
# https://www.sec.gov/os/webmaster-faq#developers. garp refuses to fall back
# to a fake default; see garp.config.MissingSecContactError.
GARP_SEC_CONTACT="Your Name your@email.example"

# Optional overrides (defaults shown).
# GARP_SEC_MIN_REQUEST_INTERVAL_SECONDS=0.11
# GARP_DATA_DIR=data
